+POSITION_ADMIN = 'Admin'
+POSITION_OPERATOR = 'Operator'
+POSITION_DRIVER = 'Хүргэгч'
+STAFF_POSITIONS = (POSITION_ADMIN, POSITION_OPERATOR)
+ROLE_POSITIONS = STAFF_POSITIONS + (POSITION_DRIVER,)
