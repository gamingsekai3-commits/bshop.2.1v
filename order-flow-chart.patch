+
+@register.simple_tag
+def order_flow():
+    """Order counts per stage, for the "Order flow" chart on the dashboard.
+
+    Every order sits in exactly one stage (`Order.status`), so the four
+    counts add up to the total. `archived` is a separate question - it is
+    the soft-delete flag (`is_active`), which cuts across the stages - so it
+    is reported on its own rather than as a fifth stage.
+
+    One GROUP BY query for the stages plus one COUNT for archived.
+    """
+    counts = dict(
+        # order_by() clears Order.Meta.ordering so it can't leak into the GROUP BY.
+        Order.objects.order_by().values_list('status').annotate(n=Count('id'))
+    )
+    total = sum(counts.values())
+
+    def stage(status):
+        n = counts.get(status, 0)
+        return {
+            'count': n,
+            'percent': int(n * 100 / total + 0.5) if total else 0,
+        }
+
+    return {
+        'total': total,
+        'pending': stage(Order.STATUS_PENDING),
+        'confirmed': stage(Order.STATUS_CONFIRMED),
+        'delivered': stage(Order.STATUS_DELIVERED),
+        'cancelled': stage(Order.STATUS_CANCELLED),
+        'archived': Order.objects.filter(is_active=False).count(),
+    }
