+/* ---- Dashboard: order flow chart ---------------------------------------
+   Stage colours follow the same light/dark switch as the rest of the admin.
+   Each node sets --of-color; the tint, outline and hover all read from it. */
+.order-flow {
+    --of-start: #777777;
+    --of-pending: #c9880a;
+    --of-confirmed: #2f6fd6;
+    --of-delivered: #27ae60;
+    --of-cancelled: #c0392b;
+}
+html[data-theme="dark"] .order-flow {
+    --of-start: #888888;
+    --of-pending: #e8c84a;
+    --of-confirmed: #5b9cf5;
+    --of-delivered: #3ecf7a;
+    --of-cancelled: #e84a4a;
+}
+
+/* On narrow screens keep the chart readable and let it scroll sideways
+   instead of shrinking the text to nothing. */
+.order-flow__scroll {
+    overflow-x: auto;
+}
+.order-flow__svg {
+    display: block;
+    width: 100%;
+    min-width: 620px;
+    height: auto;
+}
+
+.order-flow__node {
+    cursor: pointer;
+    outline: none;
+    /* Django's admin base.css underlines every link with a very specific
+       selector (a:not([role="button"], #header a, ...)), which would put a
+       line through the text in each box. !important is the simplest way to
+       win against that selector. */
+    text-decoration: none !important;
+}
+.order-flow__node--start     { --of-color: var(--of-start); }
+.order-flow__node--pending   { --of-color: var(--of-pending); }
+.order-flow__node--confirmed { --of-color: var(--of-confirmed); }
+.order-flow__node--delivered { --of-color: var(--of-delivered); }
+.order-flow__node--cancelled { --of-color: var(--of-cancelled); }
+
+.order-flow__base { fill: var(--body-bg); }
+.order-flow__tint { fill: var(--of-color); opacity: 0.10; }
+.order-flow__box  { fill: none; stroke: var(--of-color); stroke-width: 1.5; }
+
+.order-flow__node:hover .order-flow__tint,
+.order-flow__node:focus-visible .order-flow__tint { opacity: 0.20; }
+.order-flow__node:hover .order-flow__box,
+.order-flow__node:focus-visible .order-flow__box { stroke-width: 3; }
+
+.order-flow__label {
+    fill: var(--body-medium-color);
+    font-family: var(--font-family-primary);
+    font-size: 13px;
+}
+.order-flow__count {
+    fill: var(--body-loud-color);
+    font-family: var(--font-family-heading);
+    font-size: 26px;
+    font-weight: 800;
+}
+.order-flow__pct {
+    fill: var(--body-quiet-color);
+    font-family: var(--font-family-primary);
+    font-size: 12px;
+}
+
+.order-flow__arrow {
+    fill: none;
+    stroke: var(--body-quiet-color);
+    stroke-width: 1.75;
+}
+.order-flow__arrow--cancel { stroke-dasharray: 5 4; }
+.order-flow__arrowhead { fill: var(--body-quiet-color); }
+
+.order-flow__note {
+    margin: 10px 0 0;
+    font-size: 12px;
+    color: var(--body-quiet-color);
+}
+.order-flow__note a { color: var(--body-loud-color); }
+.order-flow__hint { margin-left: 4px; }
+
 /* ============================================================
